{
  "name": "oto",
  "version": "0.1.0",
  "description": "oto - desktop AI music workstation",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:all": "concurrently -k -n api,app -c \"#A7835A,#77736B\" \"npm run netease:api\" \"wait-on http://127.0.0.1:39271 && npm run dev\"",
    "dev:web": "concurrently -k -n api,server,web -c \"#A7835A,#77736B,#8A8178\" \"npm run netease:api\" \"npm run server\" \"wait-on tcp:127.0.0.1:39273 http://127.0.0.1:39271 && npm run web\"",
    "server": "OTO_SERVER_PORT=${OTO_SERVER_PORT:-39273} tsx src/server/index.ts",
    "web": "VITE_OTO_SERVER_URL=${VITE_OTO_SERVER_URL:-http://127.0.0.1:39273} VITE_PORT=${VITE_PORT:-39275} vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "netease:api": "PORT=${OTODESK_NETEASE_PORT:-39271} NeteaseCloudMusicApi",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "bundle:fluidsynth:darwin": "node scripts/bundle-fluidsynth-darwin.mjs",
    "dist": "npm run build && electron-builder",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run typecheck",
    "test:music-apis": "node scripts/test-music-generation-apis.mjs",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.oto.app",
    "productName": "oto",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/soundfonts",
        "to": "soundfonts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/openai-compatible": "^2.0.45",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@tonejs/midi": "^2.0.28",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "@web-kits/audio": "^0.1.0",
    "ai": "^6.0.174",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-vue-next": "^1.0.0",
    "media-chrome": "^4.19.0",
    "motion-v": "^2.2.1",
    "pinia": "^2.3.1",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.13",
    "concurrently": "^9.2.1",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "NeteaseCloudMusicApi": "^4.31.0",
    "shadcn-vue": "^2.6.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vue-tsc": "^2.2.8",
    "wait-on": "^9.0.5"
  }
}
