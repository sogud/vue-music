{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    },
    "types": ["node", "electron-vite/node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "src/shared/**/*.ts",
    "src/server/**/*.ts",
    "src/main/index.ts",
    "src/main/window.ts",
    "src/main/env.ts",
    "src/main/ipc/register-ipc.ts",
    "src/main/ipc/music.ipc.ts",
    "src/main/ipc/analysis.ipc.ts",
    "src/main/ipc/inspiration.ipc.ts",
    "src/main/ipc/composition.ipc.ts",
    "src/main/ipc/project.ipc.ts",
    "src/main/ipc/render.ipc.ts",
    "src/main/ipc/settings.ipc.ts",
    "src/main/services/music/**/*.ts",
    "src/main/services/ai/**/*.ts",
    "src/main/services/pi/**/*.ts",
    "src/main/services/analysis/analysis-service.ts",
    "src/main/services/inspiration/inspiration-service.ts",
    "src/main/services/composition/**/*.ts",
    "src/main/services/midi/**/*.ts",
    "src/main/services/render/**/*.ts",
    "src/main/services/project/**/*.ts",
    "src/main/services/settings/settings-service.ts",
    "src/main/storage/**/*.ts",
    "src/main/types/**/*.ts",
    "src/main/utils/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue"
  ]
}
